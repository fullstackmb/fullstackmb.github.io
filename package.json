      "email": "amir@barylko.com"
    },
    {
      "name": "Oleksandr Paiziak",
      "email": "paiziak.o@gmail.com"
    }
  ],
  "license": "MIT",
  "description": "",
  "type": "module",
  "dependencies": {
    "@11ty/eleventy-fetch": "^6.0.1",
    "child_process": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "dompurify": "^3.4.17",
    "jsdom": "^26.0.0",
    "jsx-async-runtime": "^0.1.8",
    "marked": "^15.0.6",
    "node-ical": "^0.27.3",
    "path": "^0.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-toastify": "^11.2.0",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.24",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1"
  }
}
